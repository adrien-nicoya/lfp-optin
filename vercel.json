{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/variant-(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/replay",
      "destination": "/replay.html"
    }
  ]
}